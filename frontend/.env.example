# Public Supabase configuration (safe for the browser).
# Copy this file to frontend/.env.local and fill in the values from your
# Supabase project (Settings → API).
#
# These are PUBLIC values (anon/publishable key). Never put the
# SUPABASE_SERVICE_ROLE_KEY here or anywhere in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY
